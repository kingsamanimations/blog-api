# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/blog-api"

# Long random string used to sign login tokens
JWT_SECRET="long-string"

# Port the API listens on
PORT=3000

# Front-end addresses allowed to call the API, comma-separated, no trailing slashes
CORS_ORIGINS="http://localhost:8080,http://localhost:8081"

# Password for the author account, used only by the seed script
SEED_PASSWORD="add-password"
